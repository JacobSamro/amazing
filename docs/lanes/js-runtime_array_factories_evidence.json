  "changes": [
    "Array.from/of construct custom receivers and pass the specified argument list",
    "Array.from caches iterator method and next once, advancing lazily between mapper calls",
    "Mapper and data-definition errors close the iterator while retaining original error precedence",
    "Iterator step/done/value errors propagate without an extra close",
    "Factories create own data properties and perform the required throwing length Set"
  ],
  "limitations": [
    "The existing generic iterator limit of 100000 items now applies consistently to all factory iterable inputs; array-like inputs retain the 1000000 limit",
    "Proxy support and Array.fromAsync remain separate areas"
  ],
  "specifications": [
    "https://tc39.es/ecma262/multipage/indexed-collections.html#sec-array.from",
    "https://tc39.es/ecma262/multipage/indexed-collections.html#sec-array.of"
  ]
