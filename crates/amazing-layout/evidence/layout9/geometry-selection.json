    {"id":"sizing002-width","source":"css/css-sizing/svg-intrinsic-size-002.html","subtest":"viewBox and width","container_width":600,"svg":"<svg width='40' viewBox='0 0 4 1'></svg>","expected":[40,10]},
    {"id":"sizing002-both","source":"css/css-sizing/svg-intrinsic-size-002.html","subtest":"viewBox, width, height","container_width":600,"svg":"<svg width='40' height='40' viewBox='0 0 4 1'></svg>","expected":[40,40]},
